
POSTGRES_USER=lumari
POSTGRES_PASSWORD=lumari_dev
POSTGRES_DB=lumari
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://lumari:lumari_dev@postgres:5432/lumari
QDRANT_URL=http://qdrant:6333
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

LLM_MODEL=gemini/gemini-2.0-flash
GEMINI_API_KEY=your-gemini-api-key-here

LLM_TIMEOUT=120.0

API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

API_SECRET=change-this-in-production
RATE_LIMIT_PER_MINUTE=30

FAILURE_HISTORY_MAX_ITEMS=5
FAILURE_HISTORY_DAYS=30

SKILL_DIRECTORY_ENABLED=false
SKILL_DIRECTORY_PATH=/var/lumari/skills

HOT_RELOAD_ENABLED=false